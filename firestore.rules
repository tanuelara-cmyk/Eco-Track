rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'tanu.elara@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Allow reading user profiles so profile headers and authors load properly
      allow read: if true;

      // Users can create or update their own profile; admins can also manage
      allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin());

      // Only admins or profile owner can delete
      allow delete: if isOwner(userId) || isAdmin();
    }

    // REPORTS COLLECTION
    match /reports/{reportDocId} {
      // Allow public read so citizens and visitors can view community waste reports
      allow read: if true;

      // Reports can be submitted with 'Pending' status
      allow create: if request.resource.data.status == 'Pending';

      // Admin (tanu.elara@gmail.com) can update report statuses; report owners can update their report details
      allow update: if isAdmin() || (isAuthenticated() && isOwner(resource.data.userId));

      // Admin can manage/delete reports
      allow delete: if isAdmin();
    }

    // CLUSTERS COLLECTION
    match /clusters/{clusterId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

